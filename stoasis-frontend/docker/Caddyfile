{
  admin off
  auto_https off
  persist_config off
  servers {
    trusted_proxies static private_ranges 100.0.0.0/8
  }
}

:{$PORT:8080} {
  encode zstd gzip

  handle /healthz {
    respond "ok" 200
  }

  @api path /api /api/*
  handle @api {
    reverse_proxy {$BACKEND_URL}
  }

  handle {
    root * {$APP_ROOT}
    try_files {path} /index.html
    file_server
  }
}
