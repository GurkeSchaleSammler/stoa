# Public HTTPS origin of this service. The MCP endpoint is PUBLIC_BASE_URL/mcp.
PUBLIC_BASE_URL=http://localhost:3000

# Internal or public Stoasis backend URL (without /api).
STOASIS_API_BASE_URL=http://localhost:4000

# User-facing Stoasis frontend URL used for links returned to ChatGPT.
STOASIS_WEB_BASE_URL=http://localhost:8080

PORT=3000
TRUST_PROXY=false

# Production: PostgreSQL is required for OAuth clients, codes and tokens.
# DATABASE_URL=postgresql://user:password@host:5432/database
OAUTH_STORAGE=memory

# Required in production. Generate with: openssl rand -base64 32
# SESSION_ENCRYPTION_KEY=

# Name of the session cookie issued by the Stoasis backend.
STOASIS_SESSION_COOKIE=stoasis_session

# OAuth lifetimes.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
LOGIN_TRANSACTION_TTL_SECONDS=600

# Request limits.
STOASIS_REQUEST_TIMEOUT_MS=12000
MAX_JSON_BODY=1mb
